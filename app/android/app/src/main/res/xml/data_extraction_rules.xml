<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+): nothing leaves the device through cloud backup or
  device-to-device transfer. The Supabase session (shared_prefs) and the Hive
  cache / offline queue (app_flutter) must never be restored onto another
  phone, so every domain is excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
